        delUrl: '<?php echo url_backend("del") ?>',
        uploadUrl: '<?php echo url_backend("upload/upload") ?>',
        title: '数据表',
        pk: 'id',
        cols: [[
            {type: 'checkbox', fixed: 'left'}
            ,{field: 'id', title: 'ID',width:100,sort:true}
            , {
                field: 'cover_thumb', title: '封面', width: 130, templet: function (d) {
                    if(d.cover_thumb){
                        return '<img src="' + d.cover_thumb_url + '" style="width: 100px;height: 80px;" onclick="show_img(\'' + d.cover_thumb_url + '\')">';
                    }else{
                        return '--';
                    }
                }
            }
            , {field: 'title', title: '标题', width: 180 ,templet:'#cover-title'}
